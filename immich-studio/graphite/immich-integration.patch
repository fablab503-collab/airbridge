 }
+
+// Immich Studio: open a photo given in the URL hash, e.g.
+// #immich-open=<photo url>&immich-name=<file name>&immich-return=<url that receives the exported file>
+export async function loadImmichPhoto(editor: EditorWrapper) {
+	const params = new URLSearchParams(window.location.hash.replace(/^#/, ""));
+	const source = params.get("immich-open");
+	if (!source) return;
+
+	const returnUrl = params.get("immich-return");
+	if (returnUrl) sessionStorage.setItem("immich-return", returnUrl);
+
+	try {
+		const response = await fetch(source, { credentials: "include" });
+		if (!response.ok) throw new Error(`${response.status}`);
+		const content = await response.bytes();
+		const filename = params.get("immich-name") || "Immich photo.jpg";
+		editor.ingestPicked(filename, response.headers.get("content-type") || "image/jpeg", content, "Open");
+		history.replaceState("", "", `${window.location.pathname}${window.location.search}`);
+	} catch {
+		editor.errorDialog("Could not open the Immich photo", "Immich Studio could not fetch the photo. Is Immich running?");
+	}
+}
