{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gimmich",
  "version": "1.0.0",
  "identifier": "app.gimmich.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Gimmich photos",
    "longDescription": "Opens your own Gimmich (Immich + Studio) photo server in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
